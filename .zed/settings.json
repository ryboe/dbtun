{
	"languages": {
		"Go": {
			"language_servers": ["gopls", "golangci-lint"],
		},
	},
	"lsp": {
		"gopls": {
			"initialization_options": {
				"codelenses": {
					"generate": true,
					"vulncheck": true,
				},
				"gofumpt": true,
				"vulncheck": "Imports",
			},
		},
		"golangci-lint": {
			"initialization_options": {
				"command": [
					"golangci-lint",
					"run",
					"--output.json.path=stdout",
					"--output.text.path=",
					"--show-stats=false",
				],
			},
		},
	},
}
